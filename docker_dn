#!/usr/bin/env bash
set -eo pipefail

# This script was developed for use in Moby's CI, and as such the use cases and
# usability are (intentionally) limited. You may find this script useful for
# educational purposes, for example, to learn how pulling images works "under
# the hood", and you may be able to use it for other purposes, but it should not
# be considered a "general purpose" tool for pulling images.
#
# The project maintainers accept contributions to this script within its intended
# scope, but may not accept contributions beyond that.
#
# For users who have a similar need but require more flexibility/functionality,
# refer to the discussion on GitHub, which mentions various alternatives that
# are more suitable for other uses: https://github.com/moby/moby/issues/40857

# hello-world                      latest              ef872312fe1b        3 months ago        910 B
# hello-world                      latest              ef872312fe1bbc5e05aae626791a47ee9b032efa8f3bda39cc0be7b56bfe59b9   3 months ago        910 B

# debian                           latest              f6fab3b798be        10 weeks ago        85.1 MB
# debian                           latest              f6fab3b798be3174f45aa1eb731f8182705555f89c9026d8c1ef230cbf8301dd   10 weeks ago        85.1 MB

# check if essential commands are in our PATH
for cmd in curl jq aria2c tar gzip; do
	if ! command -v "$cmd" &>/dev/null; then
		echo >&2 "error: \"$cmd\" not found!"
		exit 1
	fi
done

# container runtime used for loading archives (docker or podman)
runtimeArg="${CONTAINER_RUNTIME:-}"
detect_runtime() {
	if [ -n "$runtimeArg" ]; then
		case "$runtimeArg" in
			docker | podman)
				if ! command -v "$runtimeArg" &>/dev/null; then
					echo >&2 "error: requested runtime \"$runtimeArg\" not found"
					exit $EX_USAGE
				fi
				RUNTIME="$runtimeArg"
				;;
			*)
				echo >&2 "error: invalid runtime \"$runtimeArg\" (expected: docker or podman)"
				exit $EX_USAGE
				;;
		esac
		return 0
	fi

	if command -v podman &>/dev/null; then
		RUNTIME="podman"
	elif command -v docker &>/dev/null; then
		RUNTIME="docker"
	else
		RUNTIME=""
	fi
}

###########################################
# Cleanup on failure (#7)
###########################################
_download_complete=0
_cleanup() {
	local rc=$?
	if [ "$rc" -eq "$EX_DOWNLOAD" ] && [ "$_download_complete" -eq 0 ]; then
		echo >&2 "  partial download kept in '$dir' (can be resumed with same command)"
	fi
}
trap _cleanup EXIT
###########################################

# Exit codes
EX_OK=0       # success
EX_USAGE=1    # dependency missing / usage error
EX_AUTH=2     # auth failure
EX_DOWNLOAD=3 # download / checksum failure
EX_DOCKER=4   # container runtime load failure

VERSION="1.3.0"

# Colors (disabled when not a terminal or --quiet)
setup_colors() {
	if [ -t 1 ] && [ "${quiet:-0}" -eq 0 ]; then
		GREEN='\033[0;32m'
		YELLOW='\033[0;33m'
		NC='\033[0m'
	else
		GREEN='' YELLOW='' NC=''
	fi
}

usage() {
	echo "usage: $0 -d dir -i image[:tag][@digest] ... [options]"
	echo "       $0 -d /tmp/old-hello-world -i hello-world:latest"
	echo ""
	echo "Options:"
	echo "  -d DIR        Output directory for downloading layers"
	echo "  -i IMAGE      Image name with optional tag/digest (can be repeated)"
	echo "  -f FILE       Read image list from file (one per line)"
	echo "  -o FILE       Archive output filename (default: <image>.tar.gz)"
	echo "  --proxy URL   Proxy URL for curl and aria2c (e.g. http://host:port)"
	echo "  --runtime NAME  Container runtime for loading (docker or podman; default: auto-detect, or CONTAINER_RUNTIME)"
	echo "  --clean       Remove download directory after successful load"
	echo "  --no-load     Download and archive only, skip container runtime load"
	echo "  --dry-run     Show what would be downloaded, then exit"
	echo "  --verbose     Show debug output"
	echo "  --quiet       Suppress non-error output"
	echo "  --version     Show version"
	echo "  -h, -?        Show this help message"
	[ -z "$1" ] || exit "$1"
}

dir=
imageArgs=()
clean=0
noLoad=0
dryRun=0
proxyUrl=
archiveOut=
verbose=0
quiet=0
runtimeArg="${CONTAINER_RUNTIME:-}"

while [ $# -gt 0 ]; do
	case "$1" in
		-d)
			dir="$2"
			shift 2
			;;
		-i)
			imageArgs+=("$2")
			shift 2
			;;
		-f)
			if [ ! -f "$2" ]; then
				echo >&2 "error: file '$2' not found"
				exit $EX_USAGE
			fi
			while IFS= read -r line; do
				line="${line%%#*}"    # strip comments
				line="${line// /}"   # strip spaces
				[ -z "$line" ] && continue
				imageArgs+=("$line")
			done < "$2"
			shift 2
			;;
		-o)
			archiveOut="$2"
			shift 2
			;;
		--proxy)
			proxyUrl="$2"
			shift 2
			;;
		--runtime)
			runtimeArg="$2"
			shift 2
			;;
		--clean)
			clean=1
			shift
			;;
		--no-load)
			noLoad=1
			shift
			;;
		--dry-run)
			dryRun=1
			shift
			;;
		--verbose)
			verbose=1
			shift
			;;
		--quiet)
			quiet=1
			shift
			;;
		--version | -v)
			echo "docker_dn $VERSION"
			exit $EX_OK
			;;
		-h | -?)
			usage 0
			;;
		*)
			echo >&2 "error: unknown option '$1'"
			usage $EX_USAGE >&2
			;;
	esac
done

# build proxy args for curl and aria2c
proxyArgs=()
if [ -n "$proxyUrl" ]; then
	proxyArgs=(--proxy "$proxyUrl")
fi

# initialize colors (needs quiet to be set)
setup_colors

# resolve container runtime (may be overridden via --runtime / CONTAINER_RUNTIME)
detect_runtime

# disk space check
check_disk_space() {
	local totalBytes="$1"
	local targetDir="$2"
	if [ "$totalBytes" -eq 0 ]; then return 0; fi
	local totalMB=$((totalBytes / 1024 / 1024))
	local availKB
	availKB="$(df -k "$targetDir" 2>/dev/null | awk 'NR==2{print $4}')"
	local availMB=$((availKB / 1024))
	if [ "$availMB" -lt "$totalMB" ]; then
		echo -e "${YELLOW}warning: estimated image size ${totalMB}MB exceeds available disk space ${availMB}MB${NC}" >&2
	fi
}

if [ -z "$dir" ] || [ ${#imageArgs[@]} -eq 0 ]; then
	echo >&2 "error: -d and -i are required"
	usage $EX_USAGE >&2
fi

# container runtime is required only when we will load the archive
if [ "$dryRun" -eq 0 ] && [ "$noLoad" -eq 0 ] && [ -z "$RUNTIME" ]; then
	echo >&2 "error: neither \"docker\" nor \"podman\" found (required for loading; use --no-load to skip)"
	exit $EX_USAGE
fi

if [ -e "$dir" ] && [ ! -d "$dir" ]; then
	echo >&2 "error: '$dir' exists and is not a directory"
	exit $EX_USAGE
fi
mkdir -p "$dir" || { echo >&2 "error: cannot create directory '$dir'"; exit $EX_USAGE; }
[ -w "$dir" ] || { echo >&2 "error: directory '$dir' is not writable"; exit $EX_USAGE; }
touch "$dir/.done"

# prevent two instances from writing to the same dir at once
exec 9>"$dir/.docker_dn.lock"
if ! flock -n 9; then
	echo >&2 "error: another docker_dn instance is using '$dir' (lock held)"
	exit $EX_USAGE
fi

# pass collected images to the processing loop
set -- "${imageArgs[@]}"

# hacky workarounds for Bash 3 support (no associative arrays)
rm -f "$dir"/tags-*.tmp
rm -rf "$dir/.meta" "$dir/.manifest_entries" "$dir/.bloblocks"
mkdir -p "$dir/.meta" "$dir/.manifest_entries" "$dir/.bloblocks"
manifestJsonEntries=()
doNotGenerateManifestJson=
# repositories[busybox]='"latest": "...", "ubuntu-14.04": "..."'

# bash v4 on Windows CI requires CRLF separator... and linux doesn't seem to care either way
newlineIFS=$'\n'
major=$(echo "${BASH_VERSION%%[^0.9]}" | cut -d. -f1)
if [ "$major" -ge 4 ]; then
	newlineIFS=$'\r\n'
fi

# Registry support: auto-detect from image prefix
# Supported: docker.io (default), ghcr.io, gcr.io, quay.io
detect_registry() {
	local fullImage="$1"
	registryType="docker.io"
	registryBase='https://registry-1.docker.io'
	authBase='https://auth.docker.io'
	authService='registry.docker.io'
	image="$fullImage"

	case "$fullImage" in
		ghcr.io/*)
			registryType="ghcr.io"
			registryBase='https://ghcr.io'
			authBase='https://ghcr.io'
			authService='ghcr.io'
			image="${fullImage#ghcr.io/}"
			;;
		gcr.io/*)
			registryType="gcr.io"
			registryBase='https://gcr.io'
			authBase='https://gcr.io'
			authService='gcr.io'
			image="${fullImage#gcr.io/}"
			;;
		quay.io/*)
			registryType="quay.io"
			registryBase='https://quay.io'
			authBase='https://quay.io'
			authService='quay.io'
			image="${fullImage#quay.io/}"
			;;
	esac

	# Docker Hub: add library/ prefix for official images
	if [ "$registryType" = "docker.io" ] && [[ "$image" != *"/"* ]]; then
		image="library/$image"
	fi
}

get_token() {
	local repoImage="$1"
	local tokenUrl
	case "${registryType:-docker.io}" in
		docker.io | ghcr.io)
			tokenUrl="$authBase/token?service=$authService&scope=repository:$repoImage:pull"
			;;
		gcr.io)
			tokenUrl="https://gcr.io/v2/token?scope=repository:$repoImage:pull&service=gcr.io"
			;;
		quay.io)
			tokenUrl="https://quay.io/v2/auth?scope=repository:$repoImage:pull"
			;;
	esac
	local curlFlags=(-fsSL)
	if [ "$quiet" -eq 1 ]; then curlFlags+=(-s); fi
	if [ "$verbose" -eq 1 ]; then curlFlags+=(-v); fi
	curl "${curlFlags[@]}" "${proxyArgs[@]}" --retry 3 --retry-all-errors "$tokenUrl" | jq --raw-output '.token'
}

# Cached registry token for the current image. Registry tokens are valid for
# ~300s, so fetch once per image rather than once per layer, and
# re-authenticate only when a request actually comes back 401.
registryToken=

refresh_token() {
	registryToken="$(get_token "$1")"
}

# record completed blob hash for resume (safe under concurrent jobs)
record_done() {
	local hash="$1"
	(
		flock 9
		grep -qx "$hash" "$dir/.done" 2>/dev/null || echo "$hash" >> "$dir/.done"
	) 9>"$dir/.done.lock"
}

# https://github.com/moby/moby/issues/33700
fetch_blob() {
	local image="$1"
	shift
	local digest="$1"
	shift
	local targetFile="$1"
	shift
	local quietMode="$1" # "-s" for silent (config files)

	# resume: skip if digest already recorded as done
	local digestHash="${digest#sha256:}"
	if [ -f "$dir/.done" ] && grep -q "^${digestHash}$" "$dir/.done" 2>/dev/null; then
		echo "  [resume] skipping ${digestHash:0:12}"
		return 0
	fi

	# skip if target file already exists and is non-empty
	if [ -s "$targetFile" ]; then
		echo "  [resume] skipping ${digestHash:0:12} (file exists)"
		record_done "$digestHash"
		return 0
	fi

	# serialize concurrent blob downloads (important for parallel multi-image mode)
	mkdir -p "$dir/.bloblocks"
	local lockFile="$dir/.bloblocks/${digestHash}.lock"
	exec 8>"$lockFile"
	flock 8

	# re-check after acquiring lock (another worker may have completed it)
	if [ -f "$dir/.done" ] && grep -q "^${digestHash}$" "$dir/.done" 2>/dev/null; then
		echo "  [resume] skipping ${digestHash:0:12}"
		flock -u 8
		exec 8>&-
		return 0
	fi
	if [ -s "$targetFile" ]; then
		echo "  [resume] skipping ${digestHash:0:12} (file exists)"
		record_done "$digestHash"
		flock -u 8
		exec 8>&-
		return 0
	fi

	# get response headers to detect redirect
	local httpHeaders
	httpHeaders="$(
		curl -sI \
			"${proxyArgs[@]}" \
			-H "Authorization: Bearer $registryToken" \
			"$registryBase/v2/$image/blobs/$digest"
	)"
	httpHeaders="$(echo "$httpHeaders" | tr -d '\r')"

	# 401 means the cached token expired part-way through this image.
	# Refresh once and re-probe. A second consecutive 401 is a genuine
	# auth failure rather than an expiry, so stop instead of looping. The
	# refreshed token lands in the global, so every later layer of this
	# image reuses it instead of re-authenticating.
	if grep -qE '^HTTP/[0-9.]+ 401' <<<"$httpHeaders"; then
		refresh_token "$image"
		httpHeaders=$(
			curl -sI \
			"${proxyArgs[@]}" \
			-H "Authorization: Bearer $registryToken" \
			"$registryBase/v2/$image/blobs/$digest"
		)
		httpHeaders="$(echo "$httpHeaders" | tr -d '\r')"
		if grep -qE '^HTTP/[0-9.]+ 401' <<<"$httpHeaders"; then
			echo >&2 "error: registry rejected token for '$image' (401)"
			flock -u 8
			exec 8>&-
			return $EX_AUTH
		fi
	fi

	local blobUrl
	case "$httpHeaders" in
		*"3"[0-9][0-9]*)
			blobUrl="$(echo "$httpHeaders" | awk -F ': ' 'tolower($1) == "location" { print $2; exit }')"
			if [ -z "$blobUrl" ]; then
				echo >&2 "error: failed fetching '$image' blob '$digest'"
				echo "$httpHeaders" | head -1 >&2
				flock -u 8
				exec 8>&-
				return 1
			fi
			;;
		*)
			blobUrl="$registryBase/v2/$image/blobs/$digest"
			;;
	esac

	# download via aria2c
	local aria2Args=(-c -s16 -x16 -j4)
	if [ "$quiet" -eq 1 ] || [ "$quietMode" = "-s" ]; then
		aria2Args+=(--quiet)
	fi
	# redirect URLs (signed CDN) don't need auth header; direct URLs do
	case "$httpHeaders" in
		*"3"[0-9][0-9]*) ;;
		*) aria2Args+=("--header=Authorization: Bearer $registryToken") ;;
	esac
	if [ -n "$proxyUrl" ]; then
		aria2Args+=("--all-proxy=$proxyUrl")
	fi
	if ! aria2c "${aria2Args[@]}" "$blobUrl" -o "$targetFile"; then
		echo >&2 "error: aria2c failed for blob ${digestHash:0:12}"
		flock -u 8
		exec 8>&-
		return $EX_DOWNLOAD
	fi

	# checksum verification
	local expected="${digest#sha256:}"
	local actual
	actual="$(sha256sum "$targetFile" | cut -d' ' -f1)"
	if [ "$actual" != "$expected" ]; then
		echo >&2 "error: checksum mismatch for blob ${digestHash:0:12}"
		echo >&2 "  expected: $expected"
		echo >&2 "  actual:   $actual"
		rm -f "$targetFile"
		flock -u 8
		exec 8>&-
		return $EX_DOWNLOAD
	fi

	# record success for resume
	record_done "$digestHash"
	flock -u 8
	exec 8>&-
}

# handle 'application/vnd.docker.distribution.manifest.v2+json' manifest
handle_single_manifest_v2() {
	local manifestJson="$1"
	shift

	# disk space check
	local totalBytes
	totalBytes="$(echo "$manifestJson" | jq '[.layers[].size] | add // 0')"
	check_disk_space "$totalBytes" "$dir"

	local configDigest
	configDigest="$(echo "$manifestJson" | jq --raw-output '.config.digest')"
	# imageId must stay global: the caller's repositories writer (line ~740)
	# reads it after this function returns, and the old-style repositories
	# file keys tags to the last layer ID (see line ~503).
	imageId="${configDigest#*:}" # strip off "sha256:"

	# dry-run: show manifest info and return
	if [ "$dryRun" -eq 1 ]; then
		local layerCount
		layerCount="$(echo "$manifestJson" | jq '.layers | length')"
		local totalSizeMB=$((totalBytes / 1024 / 1024))
		echo -e "${GREEN}[dry-run]${NC} $imageIdentifier — ${layerCount} layers, ~${totalSizeMB}MB"
		local i=0
		while [ "$i" -lt "$layerCount" ]; do
			local lDigest lSize
			lDigest="$(echo "$manifestJson" | jq -r ".layers[$i].digest")"
			lSize="$(echo "$manifestJson" | jq ".layers[$i].size")"
			local lSizeMB=$((lSize / 1024 / 1024))
			echo "  [$((i+1))/${layerCount}] ${lDigest:7:12}  (~${lSizeMB}MB)"
			i=$((i + 1))
		done
		return 0
	fi

	local configFile="$imageId.json"
	fetch_blob "$image" "$configDigest" "$dir/$configFile" "-s" || return $?

	local layersFs
	layersFs="$(echo "$manifestJson" | jq --raw-output --compact-output '.layers[]')"
	local IFS="$newlineIFS"
	local layers
	mapfile -t layers <<<"$layersFs"
	unset IFS

	echo "Downloading '$imageIdentifier' (${#layers[@]} layers)..."
	local layerId=
	local layerFiles=()
	for i in "${!layers[@]}"; do
		local layerNum=$((i + 1))
		local layerMeta="${layers[$i]}"

		local layerMediaType
		layerMediaType="$(echo "$layerMeta" | jq --raw-output '.mediaType')"
		local layerDigest
		layerDigest="$(echo "$layerMeta" | jq --raw-output '.digest')"

		if [ "$quiet" -eq 0 ]; then
			echo "  [${layerNum}/${#layers[@]}] ${layerDigest:7:12}"
		fi

		# save the previous layer's ID
		local parentId="$layerId"
		# create a new fake layer ID based on this layer's digest and the previous layer's fake ID
		layerId="$(echo "$parentId"$'\n'"$layerDigest" | sha256sum | cut -d' ' -f1)"
		# this accounts for the possibility that an image contains the same layer twice (and thus has a duplicate digest value)

		mkdir -p "$dir/$layerId"
		echo '1.0' >"$dir/$layerId/VERSION"

		if [ ! -s "$dir/$layerId/json" ]; then
			local parentJson
			parentJson="$(printf ', parent: "%s"' "$parentId")"
			local addJson
			addJson="$(printf '{ id: "%s"%s }' "$layerId" "${parentId:+$parentJson}")"
			# this starter JSON is taken directly from Docker's own "docker save" output for unimportant layers
			jq "$addJson + ." >"$dir/$layerId/json" <<-'EOJSON'
				{
					"created": "0001-01-01T00:00:00Z",
					"container_config": {
						"Hostname": "",
						"Domainname": "",
						"User": "",
						"AttachStdin": false,
						"AttachStdout": false,
						"AttachStderr": false,
						"Tty": false,
						"OpenStdin": false,
						"StdinOnce": false,
						"Env": null,
						"Cmd": null,
						"Image": "",
						"Volumes": null,
						"WorkingDir": "",
						"Entrypoint": null,
						"OnBuild": null,
						"Labels": null
					}
				}
			EOJSON
		fi

		case "$layerMediaType" in
		application/vnd.oci.image.layer.v1.tar+gzip | application/vnd.docker.image.rootfs.diff.tar.gzip)
			local layerTar="$layerId/layer.tar"
			layerFiles=("${layerFiles[@]}" "$layerTar")
			# TODO figure out why "-C -" doesn't work here
			# "curl: (33) HTTP server doesn't seem to support byte ranges. Cannot resume."
			# "HTTP/1.1 416 Requested Range Not Satisfiable"
			if [ -f "$dir/$layerTar" ]; then
				if [ "$quiet" -eq 0 ]; then
					echo "  [${layerNum}/${#layers[@]}] skipping ${layerId:0:12}"
				fi
				continue
			fi
			fetch_blob "$image" "$layerDigest" "$dir/$layerTar" || return $?
			;;

		*)
			echo >&2 "error: unknown layer mediaType ($imageIdentifier, $layerDigest): '$layerMediaType'"
			exit 1
			;;
		esac
	done

	# change "$imageId" to be the ID of the last layer we added (needed for old-style "repositories" file which is created later -- specifically for older Docker daemons)
	imageId="$layerId"

	# munge the top layer image manifest to have the appropriate image configuration for older daemons
	local imageOldConfig
	imageOldConfig="$(jq --raw-output --compact-output '{ id: .id } + if .parent then { parent: .parent } else {} end' "$dir/$imageId/json")"
	jq --raw-output "$imageOldConfig + del(.history, .rootfs)" "$dir/$configFile" >"$dir/$imageId/json"

	local manifestJsonEntry
	manifestJsonEntry="$(
		echo '{}' | jq --raw-output --compact-output '. + {
			Config: "'"$configFile"'",
			RepoTags: ["'"${image#library\/}:$tag"'"],
			Layers: '"$(echo '[]' | jq --raw-output --compact-output ".$(for layerFile in "${layerFiles[@]}"; do echo " + [ \"$layerFile\" ]"; done)")"'
		}'
	)"
	manifestJsonEntries=("${manifestJsonEntries[@]}" "$manifestJsonEntry")
	if [ -n "${MANIFEST_ENTRY_FILE:-}" ]; then
		echo "$manifestJsonEntry" > "$MANIFEST_ENTRY_FILE"
	fi
}

get_target_arch() {
	if [ -n "${TARGETARCH:-}" ]; then
		echo "${TARGETARCH}"
		return 0
	fi

	if type go >/dev/null; then
		go env GOARCH
		return 0
	fi

	if type dpkg >/dev/null; then
		debArch="$(dpkg --print-architecture)"
		case "${debArch}" in
		armel | armhf)
			echo "arm"
			return 0
			;;
		*64el)
			echo "${debArch%el}le"
			return 0
			;;
		*)
			echo "${debArch}"
			return 0
			;;
		esac
	fi

	if type uname >/dev/null; then
		uArch="$(uname -m)"
		case "${uArch}" in
		x86_64)
			echo amd64
			return 0
			;;
		arm | armv[0-9]*)
			echo arm
			return 0
			;;
		aarch64)
			echo arm64
			return 0
			;;
		mips*)
			echo >&2 "I see you are running on mips but I don't know how to determine endianness yet, so I cannot select a correct arch to fetch."
			echo >&2 "Consider installing \"go\" on the system which I can use to determine the correct arch or specify it explicitly by setting TARGETARCH"
			exit 1
			;;
		*)
			echo "${uArch}"
			return 0
			;;
		esac

	fi

	# default value
	echo >&2 "Unable to determine CPU arch, falling back to amd64. You can specify a target arch by setting TARGETARCH"
	echo amd64
}

get_target_variant() {
	echo "${TARGETVARIANT:-}"
}

process_one_image() {
	local seq="$1"
	local imageTag="$2"
	local MANIFEST_ENTRY_FILE="$dir/.manifest_entries/${seq}.json"
	: > "$MANIFEST_ENTRY_FILE"

	local rawImageArg="${imageTag%%[:@]*}"
	detect_registry "$rawImageArg"

	# parse image[:tag][@digest]: rest is the optional ":tag" and/or "@digest"
	local rest="${imageTag#"$rawImageArg"}"
	local tag="${rest%%@*}"
	tag="${tag#:}"
	if [ -z "$tag" ]; then
		tag="latest"
	fi
	local digest="${rest##*@}"
	if [ "$digest" = "$rest" ]; then
		digest= # no '@' → not digest-pinned
	fi
	local manifestRef
	if [ -n "$digest" ]; then
		manifestRef="$digest"
	else
		manifestRef="$tag"
	fi

	local imageFile="${rawImageArg//\//_}"

	refresh_token "$image"

	local manifestJson
	manifestJson="$(
		curl -fsSL --retry 3 --retry-all-errors \
			"${proxyArgs[@]}" \
			-H "Authorization: Bearer $registryToken" \
			-H 'Accept: application/vnd.oci.image.manifest.v1+json' \
			-H 'Accept: application/vnd.oci.image.index.v1+json' \
			-H 'Accept: application/vnd.docker.distribution.manifest.v2+json' \
			-H 'Accept: application/vnd.docker.distribution.manifest.list.v2+json' \
			-H 'Accept: application/vnd.docker.distribution.manifest.v1+json' \
			"$registryBase/v2/$image/manifests/$manifestRef"
	)"
	if [ "${manifestJson:0:1}" != '{' ]; then
		echo >&2 "error: /v2/$image/manifests/$manifestRef returned something unexpected:"
		echo >&2 "  $manifestJson"
		return 1
	fi

	local imageIdentifier="$image:$tag${digest:+@$digest}"

	local schemaVersion
	schemaVersion="$(echo "$manifestJson" | jq --raw-output '.schemaVersion')"
	case "$schemaVersion" in
	2)
		local mediaType
		mediaType="$(echo "$manifestJson" | jq --raw-output '.mediaType')"

		case "$mediaType" in
		application/vnd.oci.image.manifest.v1+json | application/vnd.docker.distribution.manifest.v2+json)
			handle_single_manifest_v2 "$manifestJson" || return $?
			;;
		application/vnd.oci.image.index.v1+json | application/vnd.docker.distribution.manifest.list.v2+json)
			local layersFs
			layersFs="$(echo "$manifestJson" | jq --raw-output --compact-output '.manifests[]')"
			local IFS="$newlineIFS"
			local layers
			mapfile -t layers <<<"$layersFs"
			unset IFS

			local found=""
			local targetArch targetVariant
			targetArch="$(get_target_arch)"
			targetVariant="$(get_target_variant)"
			# parse first level multi-arch manifest
			local i layerMeta maniArch maniVariant submanifestJson
			for i in "${!layers[@]}"; do
				layerMeta="${layers[$i]}"
				maniArch="$(echo "$layerMeta" | jq --raw-output '.platform.architecture')"
				maniVariant="$(echo "$layerMeta" | jq --raw-output '.platform.variant')"
				if [[ "$maniArch" = "$targetArch" ]] && [[ -z "$targetVariant" || "$maniVariant" = "$targetVariant" ]]; then
					digest="$(echo "$layerMeta" | jq --raw-output '.digest')"
					# get second level single manifest
					submanifestJson="$(
						curl -fsSL --retry 3 --retry-all-errors \
							"${proxyArgs[@]}" \
							-H "Authorization: Bearer $registryToken" \
							-H 'Accept: application/vnd.oci.image.manifest.v1+json' \
							-H 'Accept: application/vnd.oci.image.index.v1+json' \
							-H 'Accept: application/vnd.docker.distribution.manifest.v2+json' \
							-H 'Accept: application/vnd.docker.distribution.manifest.list.v2+json' \
							-H 'Accept: application/vnd.docker.distribution.manifest.v1+json' \
							"$registryBase/v2/$image/manifests/$digest"
					)"
					handle_single_manifest_v2 "$submanifestJson" || return $?
					found="found"
					break
				fi
			done
			if [ -z "$found" ]; then
				echo >&2 "error: manifest for ${targetArch}${targetVariant:+/${targetVariant}} is not found"
				return 1
			fi
			;;
		*)
			echo >&2 "error: unknown manifest mediaType ($imageIdentifier): '$mediaType'"
			return 1
			;;
		esac
		;;
	1)
		: > "$dir/.meta/no_manifest_json"
		echo -e "${YELLOW}warning: '$imageIdentifier' uses schemaVersion '$schemaVersion'${NC}" >&2
		echo >&2 "  this script cannot (currently) recreate the 'image config' to put in a 'manifest.json' (thus any schemaVersion 2+ images will be imported in the old way, and their 'docker history' will suffer)"
		echo >&2

		local layersFs
		layersFs="$(echo "$manifestJson" | jq --raw-output '.fsLayers | .[] | .blobSum')"
		local IFS="$newlineIFS"
		local layers
		mapfile -t layers <<<"$layersFs"
		unset IFS

		# dry-run: show manifest info and return
		if [ "$dryRun" -eq 1 ]; then
			echo -e "${GREEN}[dry-run]${NC} $imageIdentifier — ${#layers[@]} layers (schema v1, size unknown)"
			local li
			for li in "${!layers[@]}"; do
				echo "  [$((li+1))/${#layers[@]}] ${layers[$li]:7:12}"
			done
			printf '%s\n' "$rawImageArg" > "$dir/.meta/${seq}.raw"
			# schema v1 dry-run: cannot determine imageId reliably; record placeholder
			printf '%s\n' "$tag" > "$dir/.meta/${seq}.tag"
			printf '%s\n' "dryrun" > "$dir/.meta/${seq}.imageid"
			{
				flock 9
				if [ -s "$dir/tags-$imageFile.tmp" ]; then
					printf ', ' >>"$dir/tags-$imageFile.tmp"
				fi
				printf '"%s": "%s"' "$tag" "dryrun" >>"$dir/tags-$imageFile.tmp"
			} 9>"$dir/.tagslock.$imageFile"
			return 0
		fi

		local history
		history="$(echo "$manifestJson" | jq '.history | [.[] | .v1Compatibility]')"
		imageId="$(echo "$history" | jq --raw-output '.[0]' | jq --raw-output '.id')"

		echo "Downloading '$imageIdentifier' (${#layers[@]} layers)..."
		local i layerNum imageJson layerId imageLayer
		for i in "${!layers[@]}"; do
			layerNum=$((i + 1))
			imageJson="$(echo "$history" | jq --raw-output ".[${i}]")"
			layerId="$(echo "$imageJson" | jq --raw-output '.id')"
			imageLayer="${layers[$i]}"

			if [ "$quiet" -eq 0 ]; then
				echo "  [${layerNum}/${#layers[@]}] ${imageLayer:7:12}"
			fi

			mkdir -p "$dir/$layerId"
			echo '1.0' >"$dir/$layerId/VERSION"

			echo "$imageJson" >"$dir/$layerId/json"

			# TODO figure out why "-C -" doesn't work here
			# "curl: (33) HTTP server doesn't seem to support byte ranges. Cannot resume."
			# "HTTP/1.1 416 Requested Range Not Satisfiable"
			if [ -f "$dir/$layerId/layer.tar" ]; then
				if [ "$quiet" -eq 0 ]; then
					echo "  [${layerNum}/${#layers[@]}] skipping ${layerId:0:12}"
				fi
				continue
			fi
			fetch_blob "$image" "$imageLayer" "$dir/$layerId/layer.tar" || return $?
		done
		;;
	*)
		echo >&2 "error: unknown manifest schemaVersion ($imageIdentifier): '$schemaVersion'"
		return 1
		;;
	esac

	echo

	# record tags/repos info for aggregation
	printf '%s\n' "$rawImageArg" > "$dir/.meta/${seq}.raw"
	printf '%s\n' "$tag" > "$dir/.meta/${seq}.tag"
	printf '%s\n' "$imageId" > "$dir/.meta/${seq}.imageid"
	# update tags file (locked per imageFile to handle duplicate image refs)
	{
		flock 9
		if [ -s "$dir/tags-$imageFile.tmp" ]; then
			printf ', ' >>"$dir/tags-$imageFile.tmp"
		fi
		printf '"%s": "%s"' "$tag" "$imageId" >>"$dir/tags-$imageFile.tmp"
	} 9>"$dir/.tagslock.$imageFile"

	return 0
}

# process images (in parallel when multiple images are requested)
pids=()
seq=0
for imageTag in "$@"; do
	seq=$((seq + 1))
	process_one_image "$seq" "$imageTag" &
	pids+=("$!")
done

# wait for all image jobs
failed=0
for pid in "${pids[@]}"; do
	if ! wait "$pid"; then
		failed=1
	fi
done
if [ "$failed" -ne 0 ]; then
	echo >&2 "error: one or more image downloads failed"
	exit $EX_DOWNLOAD
fi

# aggregate repositories and manifest in original argument order
: > "$dir/repositories"
: > "$dir/.meta/seen_images"
images_ordered=()
seq=1
while [ "$seq" -le $# ]; do
	if [ -f "$dir/.meta/${seq}.raw" ]; then
		rawImageArg="$(cat "$dir/.meta/${seq}.raw")"
		if ! grep -Fxq "$rawImageArg" "$dir/.meta/seen_images" 2>/dev/null; then
			echo "$rawImageArg" >> "$dir/.meta/seen_images"
			images_ordered+=("$rawImageArg")
		fi
	fi
	seq=$((seq + 1))
done

echo -n '{' >"$dir/repositories"
firstImage=1
for image in "${images_ordered[@]}"; do
	imageFile="${image//\//_}"
	image="${image#library\/}"

	[ "$firstImage" ] || echo -n ',' >>"$dir/repositories"
	firstImage=
	echo -n $'\n\t' >>"$dir/repositories"
	echo -n '"'"$image"'": { '"$(cat "$dir/tags-$imageFile.tmp")"' }' >>"$dir/repositories"
done
echo -n $'\n}\n' >>"$dir/repositories"

# collect manifest entries (schema v2) in original argument order
if [ ! -f "$dir/.meta/no_manifest_json" ]; then
	entries=()
	seq=1
	while [ "$seq" -le $# ]; do
		f="$dir/.manifest_entries/${seq}.json"
		if [ -s "$f" ]; then
			entries+=("$(cat "$f")")
		fi
		seq=$((seq + 1))
	done
	if [ "${#entries[@]}" -gt 0 ]; then
		echo '[]' | jq --raw-output ".$(for entry in "${entries[@]}"; do echo " + [ $entry ]"; done)" >"$dir/manifest.json"
	else
		rm -f "$dir/manifest.json"
	fi
else
	rm -f "$dir/manifest.json"
fi

rm -f "$dir"/tags-*.tmp
rm -f "$dir"/.tagslock.* 2>/dev/null || true
rm -rf "$dir/.meta" "$dir/.manifest_entries" "$dir/.bloblocks"

echo -e "${GREEN}Download of images into '$dir' complete.${NC}"

########################################################################################################
# archive, load, cleanup
########################################################################################################
if [ "$dryRun" -eq 0 ]; then
	_download_complete=1
	if [ -n "$archiveOut" ]; then
		archiveName="$archiveOut"
	elif [ "${#images_ordered[@]}" -gt 1 ]; then
		# archive covers all images, so name it after all of them
		imageFile="$(printf '%s+' "${images_ordered[@]}" | sed 's|/|_|g;s/+$//')"
		archiveName="${imageFile}.tar.gz"
	else
		imageFile="${images_ordered[0]//\//_}"
		archiveName="${imageFile}.tar.gz"
	fi
	if [ "$quiet" -eq 0 ]; then
		tar -cvC "${dir}" --exclude='./.docker_dn.lock' --exclude='./.done' --exclude='./.done.lock' . | gzip -c -1 >"${archiveName}"
	else
		tar -cC "${dir}" --exclude='./.docker_dn.lock' --exclude='./.done' --exclude='./.done.lock' . | gzip -c -1 >"${archiveName}"
	fi
	echo -e "${GREEN}Archive saved: ${archiveName}${NC}"

	if [ "$noLoad" -eq 0 ]; then
		loadRuntime="$RUNTIME"
		if ! "$loadRuntime" info &>/dev/null; then
			if [ -z "$runtimeArg" ]; then
				altRuntime=""
				if [ "$loadRuntime" = "podman" ] && command -v docker &>/dev/null; then
					altRuntime="docker"
				elif [ "$loadRuntime" = "docker" ] && command -v podman &>/dev/null; then
					altRuntime="podman"
				fi
				if [ -n "$altRuntime" ] && "$altRuntime" info &>/dev/null; then
					echo -e "${YELLOW}warning: $loadRuntime not reachable, falling back to $altRuntime${NC}" >&2
					loadRuntime="$altRuntime"
				fi
			fi
		fi
		if ! "$loadRuntime" info &>/dev/null; then
			echo -e "${YELLOW}warning: $loadRuntime not reachable, skipping load${NC}" >&2
		else
			if ! "$loadRuntime" load -i "${archiveName}"; then
				echo >&2 "error: $loadRuntime load failed"
				exit $EX_DOCKER
			fi
		fi
	fi

	# cleanup
	if [ "$clean" -eq 1 ]; then
		rm -rf "${dir}"
	fi
fi

# remove .done files on success (no longer needed)
rm -f "$dir/.done" "$dir/.done.lock"
########################################################################################################

exit $EX_OK
